{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.internal/rule/v1.json",
  "title": "Rule definition",
  "type": "object",
  "required": ["id", "type", "status", "owner", "description"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "type": { "enum": ["threshold", "time", "state", "pattern", "policy"] },
    "status": { "enum": ["draft", "shadow", "active", "paused"] },
    "owner": { "type": "string" },
    "owner_role": { "type": "string" },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "description": { "type": "string" },
    "review_date": { "type": "string", "format": "date" },
    "playbook": { "type": ["string", "null"] },
    "allowed_actions": { "type": "array", "items": { "type": "string" } },
    "escalation": { "type": "array", "items": { "type": "object", "required": ["notify_role"], "properties": { "after": { "type": "string" }, "notify_role": { "type": "string" } } } },
    "signal": { "type": "string" },
    "scope_pages": { "type": "array", "items": { "type": "string" } },
    "baseline": { "type": "object", "properties": { "method": { "enum": ["same_weekday_median", "rolling_median", "mad", "stl_seasonal"] }, "window_days": { "type": "integer", "minimum": 7 } } },
    "condition": { "type": "object" },
    "cooldown_days": { "type": "number", "minimum": 0 },
    "due": { "type": "object", "properties": { "day_of_month": { "type": "integer", "minimum": 1, "maximum": 28 }, "date": { "type": "string", "format": "date" }, "cron": { "type": "string" } } },
    "lead_times_days": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "requires_ack": { "type": "boolean" },
    "context_tools": { "type": "array", "items": { "type": "string" } },
    "entity": { "type": "string" },
    "where": { "type": "object" },
    "schedule": { "type": "string" },
    "pattern": { "type": "object", "required": ["on"], "properties": { "on": { "type": "string" }, "where": { "type": "object" }, "after": { "type": "string" }, "within": { "type": "string" }, "key": { "type": "string" } } },
    "tool": { "type": "string" },
    "decisions": { "type": "array", "items": { "type": "object", "required": ["when", "allow"], "properties": { "when": { "type": "string" }, "allow": { "enum": ["auto", "approve", "forbid"] }, "approver_role": { "type": "string" } } } },
    "dry_run_first": { "type": "boolean" },
    "rate_limit": { "type": "string" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "threshold" } } }, "then": { "required": ["signal", "baseline", "condition", "owner_role", "severity"] } },
    { "if": { "properties": { "type": { "const": "time" } } }, "then": { "required": ["due", "lead_times_days", "owner_role"] } },
    { "if": { "properties": { "type": { "const": "state" } } }, "then": { "required": ["entity", "condition", "owner_role"] } },
    { "if": { "properties": { "type": { "const": "pattern" } } }, "then": { "required": ["pattern", "owner_role"] } },
    { "if": { "properties": { "type": { "const": "policy" } } }, "then": { "required": ["tool", "decisions"] } }
  ]
}
